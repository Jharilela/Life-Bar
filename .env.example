# Copy to .env.local and fill in your own Supabase project.
# LifeBar is self-hosted: every deployer runs their own Supabase project, so
# no one but you (and whoever you explicitly share with) ever has your data.

# Project Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: canonical URL used to build absolute share links. If unset,
# LifeBar infers it from the incoming request's Host header.
NEXT_PUBLIC_SITE_URL=
